rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for safety
    match /{document=**} {
      allow read, write: if false;
    }

    // Public access for development/testing phase to ensure no data loss
    // In production, we would lock this down to specific wallet signatures.
    match /users/{walletAddress} {
      allow read, write: if true;
      
      match /stakes/{stakeId} {
        allow read, write: if true;
      }
    }
    
    // Explicitly allow health check path
    match /test/connection {
      allow read: if true;
    }
  }
}
