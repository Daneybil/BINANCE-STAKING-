rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for safety
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated access for individuals to manage their own ledger
    // We require an anonymous session (request.auth != null) for basic protection
    match /users/{walletAddress}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Explicitly allow health check path
    match /test/connection {
      allow read: if true;
    }
  }
}
