rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for safety
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to reach their own collection based on their 0x wallet address
    // We use a simple length check and lowercase validation for robustness
    match /users/{walletAddress} {
      allow read, write: if walletAddress.size() >= 40 && walletAddress.size() <= 44;
      
      match /stakes/{stakeId} {
        allow read, write: if walletAddress.size() >= 40;
      }
    }
    
    // Explicitly allow health check path
    match /test/connection {
      allow read: if true;
    }
  }
}
